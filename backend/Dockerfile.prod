FROM python:3.12-slim

WORKDIR /srv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

COPY . .
# Production image: no [dev] extras (pytest/ruff), no --reload (that's a
# dev-only file-watcher — wasteful and unnecessary once code isn't changing
# under the running container). CMD here is the API; the scheduler service
# on Railway overrides this with a custom start command (python -m app.scheduler)
# against this same image, so both stay in sync by construction.
RUN pip install --upgrade pip && pip install -e .

# Shell form (not exec-form array) so $PORT actually expands — Railway
# assigns its own port per deploy and expects the app to bind to it.
# Migrations run on every API start (idempotent, a no-op when already at head) so a
# deploy that ships a new migration can never leave the API running against an
# older schema. Only this service uses this CMD; the scheduler overrides it.
CMD alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
