# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by docker-compose; also assembled into DATABASE_URL below) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=stock_intel
POSTGRES_PORT=5432

# Full SQLAlchemy connection strings. When running via docker-compose these are
# overridden to point at the "db" service automatically (see docker-compose.yml);
# set them here only for running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stock_intel
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stock_intel_test

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# Historical daily-bar backfill window for Phase 1 (years). Configurable, not hardcoded.
HISTORICAL_BACKFILL_YEARS=5

# Phase 4: trailing calendar days of historical feature snapshots + labels
# to (re)build per run for ML training. Bounded by design.
HISTORICAL_DATASET_DAYS=90

# Required by SEC EDGAR's fair-access policy: a descriptive User-Agent identifying
# the app and a contact address, e.g. "stock-intelligence-saas contact@example.com"
SEC_EDGAR_USER_AGENT=

# --- Market data ---
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Fundamentals (primary; also used as an EOD-price cross-check, see data-ingestion-plan.md) ---
FMP_API_KEY=

# --- Macro data (point-in-time vintages) ---
FRED_API_KEY=

# --- News (secondary/sentiment; GDELT is primary and needs no key) ---
MARKETAUX_API_KEY=

# --- News signal extraction (spec §5): real LLM, not a heuristic ---
ANTHROPIC_API_KEY=
NEWS_LLM_MODEL=claude-haiku-4-5

# How far back a single news-ingestion run looks (hours). The real ~7x/day
# sweep cadence from data-ingestion-plan_1.md §3 is a Phase 10 scheduling
# concern; this just bounds one manual/CLI run for now.
NEWS_LOOKBACK_HOURS=24

# --- Reserved / not wired into the default pipeline (see docs/data-ingestion-plan_1.md §5) ---
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- Admin panel auth (spec §16): the only access-gated area in the product ---
# Generate real values, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
ADMIN_SESSION_TTL_MINUTES=60
